{
  "name": "garmayev/yii2-fileupload",
  "description": "Yii2 widget for uploading files",
  "type": "yii2-extension",
  "keywords": ["yii2", "widget", "upload", "file"],
  "license": "MIT",
  "authors": [
    {
      "name": "garmayev",
      "email": "garmayev@yandex.ru"
    }
  ],
  "require": {
    "php": ">=7.4",
    "yiisoft/yii2": "~2.0.0",
    "npm-asset/cropperjs": "^2.1",
    "yiisoft/yii2-imagine": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "garmayev\\fileupload\\": "src/"
    }
  },
  "extra": {
    "bootstrap": "garmayev\\fileupload\\Bootstrap"
  }
}